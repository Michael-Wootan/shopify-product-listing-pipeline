# Shopify Admin API (custom app with write_products, write_publications,
# write_metaobjects, write_metaobject_definitions, write_online_store_navigation scopes)
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10

# Store identity used in vendor default, emails and live-URL links
STORE_NAME=Acme Store
STOREFRONT_URL=https://www.example.com

# Starting stock for new variants that don't set inventory_quantity in the spec
DEFAULT_INVENTORY=999

# Google Gemini image generation
GEMINI_API_KEY=your-gemini-api-key
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Summary email (any SMTP provider). If unset, the summary is printed to the log.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASS=your-smtp-password
NOTIFY_EMAIL=catalog-team@example.com
